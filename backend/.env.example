# Leylek backend ayarları. Bu dosyayı .env olarak kopyalayıp doldurun.
# .env depoya girmez (.gitignore).

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Travelpayouts Data API tokenı (https://www.travelpayouts.com).
# Yalnızca burada durur; koda ya da depoya yazılmaz.
TRAVELPAYOUTS_TOKEN=

# Transitous'a giden her istekte User-Agent içinde gönderilir.
# Transitous koşulları uygulama adı, sürüm ve iletişim bilgisi istiyor.
LEYLEK_REPO_URL=https://github.com/metinboraozke/leylek
LEYLEK_CONTACT_EMAIL=

# Transitous: yalnızca herkese açık API. Staging ya da iç uç nokta kullanılmaz.
TRANSITOUS_BASE_URL=https://api.transitous.org
# /plan isteği bütçesi (sunucu geneli). Transitous ekibinin yanıtına göre ayarlanır.
TRANSITOUS_PLAN_PER_MINUTE=30
TRANSITOUS_PLAN_PER_DAY=3000

# İstemci başına arama sınırı (dakikada).
RATE_LIMIT_PER_MINUTE=20

# İçe aktarılan veri dosyalarının klasörü (npm run data:import).
DATA_DIR=./data
