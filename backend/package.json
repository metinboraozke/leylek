{
  "name": "leylek-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Leylek backend: aktarmalı rota araması (uçuş + tren/otobüs/feribot)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:import": "tsx scripts/import-data.ts",
    "live": "tsx scripts/live-smoke.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:live": "tsx scripts/e2e.ts --live"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fflate": "^0.8.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
